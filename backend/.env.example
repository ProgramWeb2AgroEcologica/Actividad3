# ==============================================================================
# VARIABLES DE ENTORNO - UPDS ACTIVIDAD 3
# ==============================================================================
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=upds-super-secret-key-production-change-this

# SUPABASE CREDENCIALES
# Obtener de: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-anon-publica-de-supabase
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase-auth

# TIEMPO DE EXPIRACIÓN DE TOKENS (BUENAS PRÁCTICAS RFC 6749)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# POLÍTICA DE SEGURIDAD CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://mi-proyecto.onrender.com
